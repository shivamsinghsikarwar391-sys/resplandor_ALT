# Resplandor ATL - Server Environment Variables
PORT=3001
NODE_ENV=development

# JWT Secret for Admin Sessions
JWT_SECRET=resplandor_secret_jwt_key_2026_snellville

# Default Admin Credentials (initialized on first boot)
# Username: admin
ADMIN_DEFAULT_PASSWORD=Resplandor2026!

# Admin Master Recovery Key (used if salon owner forgets their email, username, or password)
ADMIN_RECOVERY_KEY=RESPLANDOR-ATL-OWNER-KEY-2026

# Notification Provider Configuration (Optional)
# If left empty, system operates in logged/unconfigured mode without pretending messages were sent.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxx
# FROM_EMAIL=Resplandor ATL <appointments@resplandor-atl.com>

# Twilio SMS Configuration (Optional)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+14705550192
