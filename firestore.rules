rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller is an authenticated salon administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'owner@resplandor-atl.com'
      );
    }

    // 1. Appointments Collection Rules
    match /appointments/{appointmentId} {
      
      // Customers can look up their own appointment by reference or phone
      // Public cannot list the entire customer database
      allow get: if true;
      allow list: if isAdmin();
      
      // Public customers can only create an appointment with status 'Pending'
      allow create: if request.resource.data.status == 'Pending'
        && request.resource.data.customer_name is string
        && request.resource.data.customer_phone is string
        && request.resource.data.appointment_date is string
        && request.resource.data.appointment_time is string
        && request.resource.data.reference is string;
      
      // Sensitive status updates (Confirmed, Rejected, Rescheduled) REQUIRE Admin privileges
      // Customers cannot approve their own appointments!
      allow update, delete: if isAdmin();
    }

    // 2. Salon Settings (Working hours, blackout dates)
    match /salon_settings/{settingId} {
      allow read: if true; // Public can view operating hours
      allow write: if isAdmin(); // Only admin can modify schedule
    }

    // 3. Audit Logs Collection
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
